# OCI Configuration
#
# Multi-tenancy is the default — tenancies are loaded from the `tenancies` table
# (seeded at deploy time from db/seed/reference_data.local.sql). One profile per
# tenancy in ~/.oci/config, keyed by each row's config_profile, e.g.:
#   [DEFAULT]    — primary tenancy (its home region)
#   [CUSTOMER01] — additional tenancy (its home region)
#
# The variables below are a single-tenancy override (used when set). Useful for
# --init-db before migrations have run, or for ad-hoc loads pinned to one tenancy.
# Leave them commented out in normal operation.
#
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..exampleuniqueID
# OCI_TENANCY_ALIAS=default
# OCI_REGION=us-ashburn-1
# OCI_CONFIG_PROFILE=DEFAULT
# OCI_NAMESPACE=bling
OCI_CONFIG_FILE=~/.oci/config

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=oci_finops
PG_USER=finops
PG_PASSWORD=changeme

# ETL Settings
ETL_BATCH_SIZE=10000
ETL_TEMP_DIR=/tmp/oci-finops
FOCUS_REPORT_YEAR=2026

# Provisional gap-fill from the OCI Usage API when FOCUS reports stall.
# Set to 0 to disable. Provisional rows are tagged source_file 'usage-api://...'
# and are auto-replaced by real FOCUS data as it catches up.
USAGE_API_BACKFILL=1

# Anomaly Detection
ANOMALY_ROLLING_WINDOW_DAYS=30
ANOMALY_STDDEV_THRESHOLD=3.0
ANOMALY_ML_CONTAMINATION=0.05

# Notifications (optional)
ONS_TOPIC_OCID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=finops-alerts@example.com
SMTP_TO=team@example.com

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
