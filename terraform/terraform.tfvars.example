tenancy_ocid      = "ocid1.tenancy.oc1..exampleuniqueID"
compartment_id    = "ocid1.compartment.oc1..exampleuniqueID"
region            = "us-ashburn-1"
ssh_public_key    = "ssh-rsa AAAA..."
pg_admin_password = "ChangeMeToAStrongPassword123!"

# Initial Grafana admin password (at least 12 characters)
grafana_admin_password = "ChangeMeToAnotherStrongPassword!"

# Existing OCI Vault and master encryption key. Both passwords are stored here
# as secrets; the compute instance fetches them at boot instead of receiving
# them in instance metadata.
vault_id     = "ocid1.vault.oc1..exampleuniqueID"
vault_key_id = "ocid1.key.oc1..exampleuniqueID"

# Optional overrides
# compute_shape     = "VM.Standard.E4.Flex"
# compute_ocpus     = 1
# compute_memory_gb = 8
# db_shape          = "PostgreSQL.VM.Standard.E4.Flex.2.32GB"
# db_storage_gb     = 32
# project_name      = "oci-finops"

# Grafana is private by default (use: ssh -L 3000:localhost:3000 opc@<ip>).
# List CIDRs here to open port 3000 to them directly.
# grafana_allowed_cidrs = ["203.0.113.0/24"]
